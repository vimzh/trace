{
  "name": "trace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "overrides": {
    "@types/node": "^24"
  },
  "scripts": {
    "setup": "bash scripts/init.sh",
    "dev": "bun run --workspaces --parallel dev",
    "build": "bun run --workspaces --if-present build",
    "eval:deterministic": "bun test packages/floor-model apps/api/src apps/web/src",
    "eval:live": "bun apps/api/scripts/run-corpus.ts run",
    "lint": "bun run --workspaces --if-present lint",
    "typecheck": "bun run --workspaces --if-present typecheck"
  }
}
