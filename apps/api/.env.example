# Local inference uses the official OpenAI API through Strands (not Bedrock).
MODEL_PROVIDER=openai
OPENAI_API_KEY=

# Visual/spatial review uses Sol; constrained prompt edits use Luna.
MODEL_CRITICAL=gpt-5.6-sol
MODEL_FAST=gpt-5.6-luna
MODEL_LAYOUT=gpt-5.6-sol
MODEL_COMPARE=gpt-5.6-sol
MODEL_MAX_OUTPUT_TOKENS=32768
MODEL_TIMEOUT_MS=600000

# Optional existing Bedrock route: set MODEL_PROVIDER=bedrock, configure the
# AWS credential chain, and replace ALL role model IDs with Bedrock IDs.
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile

# Application state
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bumps
UPLOADS_DIR=data/uploads
